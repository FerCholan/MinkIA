<?xml version="1.0" encoding="utf-8"?>
<!--
  Escala tipográfica de MinkIA: cada token de Material 3 hereda su tamaño/peso y
  solo se le cambia la fuente a Poppins. Así TODA la app (incluidos botones,
  campos de texto y toolbars, que usan estos tokens) queda en la tipografía de
  marca, no solo los TextView sueltos. Los títulos ya van en bold por su
  textStyle en los layouts; el cuerpo queda regular. (Identidad 6.1.6)
-->
<resources>
    <style name="TextAppearance.MinkIA.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.MinkIA.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
