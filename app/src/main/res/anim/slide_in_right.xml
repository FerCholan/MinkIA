<?xml version="1.0" encoding="utf-8"?>
<!-- Entrada hacia adelante: la pantalla nueva entra desde la derecha con fundido. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <translate android:fromXDelta="16%p" android:toXDelta="0" android:duration="280" />
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="220" />
</set>
