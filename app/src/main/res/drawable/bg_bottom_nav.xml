<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del bottom nav: superficie blanca con esquinas superiores redondeadas
     (look de hoja flotante). El fondo llega al borde inferior; el inset de gestos
     se resuelve con padding en código para que no quede franja. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/superficie" />
    <corners
        android:topLeftRadius="22dp"
        android:topRightRadius="22dp" />
</shape>
