<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detalleRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/verde_bosque"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/detalle_volver"
        app:title="@string/app_name"
        app:titleCentered="true"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Foto + IA -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="@drawable/bg_card_stat">

                <ImageView
                    android:id="@+id/ivFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_camara"
                    app:tint="@color/verde_hoja_claro" />

                <TextView
                    android:id="@+id/chipIa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_chip_permitido"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/verde_hoja"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="IA: Basura · 86%" />
            </FrameLayout>

            <!-- Chips -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipSeveridad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_permitir"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="ALTA" />

                <TextView
                    android:id="@+id/chipArea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_azul"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/azul"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="4.2 m²" />

                <TextView
                    android:id="@+id/chipVecinos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_permitido"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/verde_hoja"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="5 vecinos" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/detalle_seguimiento"
                android:textColor="@color/texto_principal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Timeline -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_stat"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout style="@style/PasoTimeline">
                    <ImageView android:id="@+id/dot1" style="@style/PasoDot" />
                    <LinearLayout style="@style/PasoTexto">
                        <TextView style="@style/PasoTitulo" android:text="@string/detalle_recibido" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/PasoTimeline">
                    <ImageView android:id="@+id/dot2" style="@style/PasoDot" />
                    <LinearLayout style="@style/PasoTexto">
                        <TextView style="@style/PasoTitulo" android:text="@string/detalle_validado" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/PasoTimeline">
                    <ImageView android:id="@+id/dot3" style="@style/PasoDot" />
                    <LinearLayout style="@style/PasoTexto">
                        <TextView style="@style/PasoTitulo" android:text="@string/detalle_en_ruta" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/PasoTimeline">
                    <ImageView android:id="@+id/dot4" style="@style/PasoDot" />
                    <LinearLayout style="@style/PasoTexto">
                        <TextView style="@style/PasoTitulo" android:text="@string/detalle_resuelto" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvUnion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_banner_info"
                android:padding="14dp"
                android:textColor="@color/azul"
                android:textSize="13sp"
                tools:text="Tu reporte se unió al de otros 4 vecinos en el mismo punto." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerMapa"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/detalle_ver_mapa"
                android:textColor="@color/verde_bosque"
                app:cornerRadius="14dp"
                app:strokeColor="@color/verde_bosque" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
