<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/validacionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/verde_bosque"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/app_name"
        app:titleCentered="true"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Foto -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_card_stat">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_camara"
                    app:tint="@color/verde_hoja_claro" />

                <TextView
                    android:id="@+id/chipIa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_chip_permitido"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/verde_hoja"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="IA: Basura · 86%" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_chip_ia"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="YOLOv8"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Chips -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipSeveridad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_permitir"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Severidad ALTA" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_azul"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="4.2 m²"
                    android:textColor="@color/azul"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipReportes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_permitido"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/verde_hoja"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="5 reportes" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvUnificados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_banner_info"
                android:padding="14dp"
                android:textColor="@color/verde_bosque"
                android:textSize="13sp"
                tools:text="5 reportes ciudadanos fueron unificados automáticamente en este punto crítico." />

            <!-- Detalles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_stat"
                android:orientation="vertical"
                android:padding="6dp">

                <LinearLayout style="@style/FilaConfig">
                    <TextView style="@style/FilaConfigTexto" android:textStyle="normal" android:textColor="@color/texto_secundario" android:text="@string/admin_val_ubicacion" />
                    <TextView android:id="@+id/tvUbicacion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/texto_principal" android:textStyle="bold" android:textSize="14sp" tools:text="Jr. Elías Aguirre 450" />
                </LinearLayout>
                <View style="@style/SeparadorMenu" />
                <LinearLayout style="@style/FilaConfig">
                    <TextView style="@style/FilaConfigTexto" android:textStyle="normal" android:textColor="@color/texto_secundario" android:text="@string/admin_val_primer" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/texto_principal" android:textStyle="bold" android:textSize="14sp" android:text="Hoy · 9:41 a. m." />
                </LinearLayout>
                <View style="@style/SeparadorMenu" />
                <LinearLayout style="@style/FilaConfig">
                    <TextView style="@style/FilaConfigTexto" android:textStyle="normal" android:textColor="@color/texto_secundario" android:text="@string/admin_val_tipo" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/texto_principal" android:textStyle="bold" android:textSize="14sp" android:text="Residuo domiciliario" />
                </LinearLayout>
                <View style="@style/SeparadorMenu" />
                <LinearLayout style="@style/FilaConfig">
                    <TextView style="@style/FilaConfigTexto" android:textStyle="normal" android:textColor="@color/texto_secundario" android:text="@string/admin_val_reportado" />
                    <TextView android:id="@+id/tvReportado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/texto_principal" android:textStyle="bold" android:textSize="14sp" tools:text="5 vecinos" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnValidar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/verde_bosque"
                android:text="@string/admin_val_validar"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_shield"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDuplicado"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="@string/admin_val_duplicado"
                    android:textColor="@color/texto_secundario"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/linea" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRechazar"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/admin_val_rechazar"
                    android:textColor="@color/naranja_terracota"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/naranja_terracota" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
