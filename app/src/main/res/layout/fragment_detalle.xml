<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detalleRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <!-- Header andino (mismo lenguaje que "Mis reportes" / Inicio): degradé verde +
         textura textil tenue. Recto abajo, con flecha de volver y título centrado. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_plano"
        android:minHeight="?attr/actionBarSize">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.55"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_patron_andino"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/detalle_volver"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="@id/tvTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitulo"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="18dp"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Reporte #A1B2" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollDetalle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Foto + IA -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="@drawable/bg_card_stat">

                <com.moviles.minkia.ui.common.FotoReporteView
                    android:id="@+id/fotoReporte"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/chipIa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_chip_permitido"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/verde_hoja"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="IA: Basura · 86%" />
            </FrameLayout>

            <!-- Chips -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipSeveridad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_permitir"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="ALTA" />

                <TextView
                    android:id="@+id/chipArea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_azul"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/azul"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="4.2 m²" />

                <TextView
                    android:id="@+id/chipVecinos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_permitido"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/verde_hoja"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="5 vecinos" />
            </LinearLayout>

            <!-- Autor del reporte: su insignia de nivel + su nombre (o apodo). -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivAutorNivel"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:src="@drawable/nivel_1" />

                <TextView
                    android:id="@+id/tvAutor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp"
                    tools:text="Reportado por Fernando C." />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/detalle_seguimiento"
                android:textColor="@color/texto_principal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Cartel de estado terminal (duplicado/anulado): reemplaza al timeline
                 cuando el reporte no sigue el flujo normal. Oculto por defecto. -->
            <TextView
                android:id="@+id/tvTerminal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_banner_info"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Este reporte fue anulado por la administración."
                tools:visibility="visible" />

            <!-- Timeline -->
            <LinearLayout
                android:id="@+id/cardTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_stat"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout style="@style/PasoTimeline">
                    <ImageView android:id="@+id/dot1" style="@style/PasoDot" />
                    <LinearLayout style="@style/PasoTexto">
                        <TextView style="@style/PasoTitulo" android:text="@string/detalle_recibido" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/PasoTimeline">
                    <ImageView android:id="@+id/dot2" style="@style/PasoDot" />
                    <LinearLayout style="@style/PasoTexto">
                        <TextView style="@style/PasoTitulo" android:text="@string/detalle_validado" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/PasoTimeline">
                    <ImageView android:id="@+id/dot3" style="@style/PasoDot" />
                    <LinearLayout style="@style/PasoTexto">
                        <TextView style="@style/PasoTitulo" android:text="@string/detalle_resuelto" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvUnion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_banner_info"
                android:padding="14dp"
                android:textColor="@color/azul"
                android:textSize="13sp"
                tools:text="Tu reporte se unió al de otros 4 vecinos en el mismo punto." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerMapa"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/detalle_ver_mapa"
                android:textColor="@color/verde_bosque"
                app:cornerRadius="14dp"
                app:strokeColor="@color/verde_bosque" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
