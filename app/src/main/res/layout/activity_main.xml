<?xml version="1.0" encoding="utf-8"?>
<!--
Contenedor único del ciudadano Y del administrador (FASE 2 de la migración de
18 Activities a 3 con Navigation Component). AdminMainActivity desaparece: es
esta misma Activity la que aloja, en un único NavHostFragment, uno de dos
grafos posibles según el rol de la sesión activa (nav_ciudadano o nav_admin;
ver MainActivity.configurarGrafoSegunRol).

NO se declara acá app:navGraph, por el mismo motivo que activity_auth.xml: el
grafo depende del rol, que se resuelve en código de forma asíncrona (lee la
sesión de DataStore), y declararlo también acá lo inflaría dos veces. El fondo
(@color/fondo) del root cubre el instante breve en que el NavHostFragment
todavía no tiene grafo asignado.

El BottomNavigationView trae app:menu="@menu/bottom_nav_menu" como valor "de
fábrica" (el del ciudadano), igual de fábrica-y-reemplazado-en-código que
app:startDestination en nav_auth.xml: MainActivity siempre lo reemplaza según
el rol con menu.clear() + inflateMenu(...). El FAB "Reportar" es una acción
exclusiva del ciudadano: MainActivity lo oculta cuando el grafo resuelto es el
de administrador.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHostMain"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="56dp"
        app:defaultNavHost="true" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        app:elevation="8dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabReportar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:contentDescription="@string/nav_reportar"
        android:src="@drawable/ic_camara_mas"
        app:backgroundTint="@color/naranja_terracota"
        app:borderWidth="0dp"
        app:elevation="10dp"
        app:fabCustomSize="68dp"
        app:maxImageSize="30dp"
        app:shapeAppearanceOverlay="@style/FabSquircle"
        app:tint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
