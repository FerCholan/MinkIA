<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <!-- Header andino: degradé verde + textura textil tenue (misma identidad que
         el inicio). Recto abajo porque el mapa va pegado. La textura es un ImageView
         a 0dp sobre los 4 lados: cubre el header sin inflar su altura. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerMapa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_plano">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.55"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_patron_andino"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/headerMapaContenido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mapa_titulo"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/chipTodos" style="@style/ChipMapa" android:background="@drawable/bg_chip_mapa_sel" android:text="@string/mapa_filtro_todos" android:textColor="@color/verde_bosque" />
                <TextView android:id="@+id/chipAlta" style="@style/ChipMapa" android:text="@string/mapa_filtro_alta" />
                <TextView android:id="@+id/chipMedia" style="@style/ChipMapa" android:text="@string/mapa_filtro_media" />
                <TextView android:id="@+id/chipBaja" style="@style/ChipMapa" android:text="@string/mapa_filtro_baja" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Mapa real (Google Maps). MapaFragment le agrega los marcadores de los focos. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mapaContainer"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
