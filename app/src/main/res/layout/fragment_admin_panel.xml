<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <ScrollView
        android:id="@+id/scrollPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/contenidoPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header andino: degradé verde + textura textil tenue, esquinas inferiores
             redondeadas (las recorta PanelFragment con clipToOutline). La textura es
             un ImageView a 0dp sobre los 4 lados: cubre sin inflar el alto. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_inicio">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:alpha="0.55"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_patron_andino"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/headerPanelContenido"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="22dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_panel_titulo"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/admin_panel_subtitulo"
                        android:textColor="@color/crema"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:text="@string/admin_panel_iniciales"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- KPIs 2x2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout style="@style/KpiCard">
                <TextView android:id="@+id/tvKpi1Delta" style="@style/KpiDelta" android:textColor="@color/verde_hoja" android:text="+12%" />
                <TextView android:id="@+id/tvKpi1Valor" style="@style/KpiNumero" android:text="47" />
                <TextView style="@style/KpiLabel" android:text="@string/perfil_stat_reportes" />
            </LinearLayout>

            <LinearLayout style="@style/KpiCard" android:layout_marginStart="12dp">
                <TextView android:id="@+id/tvKpi2Delta" style="@style/KpiDelta" android:textColor="@color/naranja_terracota" android:text="+3" />
                <TextView android:id="@+id/tvKpi2Valor" style="@style/KpiNumero" android:text="62" />
                <TextView style="@style/KpiLabel" android:text="@string/admin_puntos_titulo" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout style="@style/KpiCard">
                <TextView android:id="@+id/tvKpi3Delta" style="@style/KpiDelta" android:textColor="@color/verde_hoja" android:text="+8%" />
                <TextView android:id="@+id/tvKpi3Valor" style="@style/KpiNumero" android:text="38" />
                <TextView style="@style/KpiLabel" android:text="@string/perfil_stat_resueltos" />
            </LinearLayout>

            <LinearLayout style="@style/KpiCard" android:layout_marginStart="12dp">
                <TextView android:id="@+id/tvKpi4Delta" style="@style/KpiDelta" android:text=" " />
                <TextView android:id="@+id/tvKpi4Valor" style="@style/KpiNumero" android:text="81%" />
                <TextView style="@style/KpiLabel" android:text="Tasa de atención" />
            </LinearLayout>
        </LinearLayout>

        <!-- Gráfico -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="22dp"
            android:text="@string/admin_panel_grafico"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_stat"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:padding="14dp"
            android:baselineAligned="false">

            <LinearLayout style="@style/BarraCol"><View style="@style/Barra" android:layout_height="60dp" /><TextView style="@style/BarraLabel" android:text="L" /></LinearLayout>
            <LinearLayout style="@style/BarraCol"><View style="@style/Barra" android:layout_height="78dp" /><TextView style="@style/BarraLabel" android:text="M" /></LinearLayout>
            <LinearLayout style="@style/BarraCol"><View style="@style/Barra" android:layout_height="50dp" /><TextView style="@style/BarraLabel" android:text="M" /></LinearLayout>
            <LinearLayout style="@style/BarraCol"><View style="@style/Barra" android:layout_height="92dp" /><TextView style="@style/BarraLabel" android:text="J" /></LinearLayout>
            <LinearLayout style="@style/BarraCol"><View style="@style/Barra" android:layout_height="110dp" android:backgroundTint="@color/naranja_terracota" /><TextView style="@style/BarraLabel" android:text="V" /></LinearLayout>
            <LinearLayout style="@style/BarraCol"><View style="@style/Barra" android:layout_height="72dp" /><TextView style="@style/BarraLabel" android:text="S" /></LinearLayout>
            <LinearLayout style="@style/BarraCol"><View style="@style/Barra" android:layout_height="58dp" /><TextView style="@style/BarraLabel" android:text="D" /></LinearLayout>
        </LinearLayout>

        <!-- Zonas -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="22dp"
            android:text="@string/admin_panel_zonas"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card_stat"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:id="@+id/tvZona1" style="@style/ZonaNombre" android:text="P. J. La Unión" />
            <ProgressBar android:id="@+id/barraZona1" style="@style/ZonaBarra" android:progress="90" android:progressTint="@color/sev_alta" />

            <TextView android:id="@+id/tvZona2" style="@style/ZonaNombre" android:layout_marginTop="14dp" android:text="Centro histórico" />
            <ProgressBar android:id="@+id/barraZona2" style="@style/ZonaBarra" android:progress="60" android:progressTint="@color/sev_media" />

            <TextView android:id="@+id/tvZona3" style="@style/ZonaNombre" android:layout_marginTop="14dp" android:text="Miraflores Alto" />
            <ProgressBar android:id="@+id/barraZona3" style="@style/ZonaBarra" android:progress="35" android:progressTint="@color/sev_baja" />
        </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/skeletonPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:shimmer_duration="1150"
        app:shimmer_tilt="18"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header verde: título + avatar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/verde_bosque"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <View android:layout_width="190dp" android:layout_height="20dp" android:background="@drawable/bg_skeleton_claro" />
                    <View android:layout_width="140dp" android:layout_height="12dp" android:layout_marginTop="8dp" android:background="@drawable/bg_skeleton_claro" />
                </LinearLayout>

                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_skeleton_claro_circulo" />
            </LinearLayout>

            <!-- KPIs 2x2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/KpiCard">
                    <View android:layout_width="44dp" android:layout_height="26dp" android:background="@drawable/bg_skeleton" />
                    <View android:layout_width="80dp" android:layout_height="11dp" android:layout_marginTop="10dp" android:background="@drawable/bg_skeleton" />
                </LinearLayout>

                <LinearLayout style="@style/KpiCard" android:layout_marginStart="12dp">
                    <View android:layout_width="44dp" android:layout_height="26dp" android:background="@drawable/bg_skeleton" />
                    <View android:layout_width="80dp" android:layout_height="11dp" android:layout_marginTop="10dp" android:background="@drawable/bg_skeleton" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/KpiCard">
                    <View android:layout_width="44dp" android:layout_height="26dp" android:background="@drawable/bg_skeleton" />
                    <View android:layout_width="80dp" android:layout_height="11dp" android:layout_marginTop="10dp" android:background="@drawable/bg_skeleton" />
                </LinearLayout>

                <LinearLayout style="@style/KpiCard" android:layout_marginStart="12dp">
                    <View android:layout_width="44dp" android:layout_height="26dp" android:background="@drawable/bg_skeleton" />
                    <View android:layout_width="80dp" android:layout_height="11dp" android:layout_marginTop="10dp" android:background="@drawable/bg_skeleton" />
                </LinearLayout>
            </LinearLayout>

            <!-- Título gráfico -->
            <View
                android:layout_width="160dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_skeleton" />

            <!-- Gráfico -->
            <View
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_stat" />

            <!-- Título zonas -->
            <View
                android:layout_width="150dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_skeleton" />

            <!-- Card zonas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="@drawable/bg_card_stat"
                android:orientation="vertical"
                android:padding="16dp">

                <View android:layout_width="120dp" android:layout_height="12dp" android:background="@drawable/bg_skeleton" />
                <View android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="10dp" android:background="@drawable/bg_skeleton" />
                <View android:layout_width="120dp" android:layout_height="12dp" android:layout_marginTop="16dp" android:background="@drawable/bg_skeleton" />
                <View android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="10dp" android:background="@drawable/bg_skeleton" />
            </LinearLayout>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>
