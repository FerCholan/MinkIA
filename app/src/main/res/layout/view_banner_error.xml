<?xml version="1.0" encoding="utf-8"?>
<!-- Banner de error inline reutilizable (login, registro, recuperar). Reemplaza
     a los Toast: feedback elegante en la paleta de marca. La visibilidad y los
     márgenes los define cada pantalla en su <include>. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_banner_error"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_alerta" />

    <TextView
        android:id="@+id/tvBannerError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:textColor="@color/naranja_terracota_osc"
        android:textSize="14sp" />
</LinearLayout>
