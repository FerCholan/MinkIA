<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Red: Firebase (auth/firestore) y subida de fotos a Cloudinary -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Detectar cuándo vuelve la conexión para reenviar los reportes en cola -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permisos del flujo de reporte (pedidos en tiempo de ejecución en C06) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- POST_NOTIFICATIONS NO se declara: los avisos de MinkIA se generan y se leen
         dentro de la app (ui/notificaciones), no se publica ninguna notificacion del
         sistema. Pedir un permiso que no se usa desgasta la confianza del vecino. -->

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".MinkIaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/reglas_backup"
        android:fullBackupContent="@xml/reglas_backup_legacy"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MinkIA"
        tools:targetApi="31">

        <!-- Google Maps: la API key vive en strings.xml (conviene restringirla por
             paquete + SHA-1 en Google Cloud para que solo funcione en esta app). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MinkIA.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Contenedora del flujo de acceso (Navigation Component): reemplaza
             a las 6 Activities de onboarding/login/registro/recuperar/
             términos/permisos, ahora fragments del grafo nav_auth. -->
        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="false" />

        <!-- Captura/Análisis/Formulario/Confirmación (FASE 4) dejaron de ser
             Activities: son el grafo nav_reporte, que nav_ciudadano.xml
             incluye e infla dentro del NavHostFragment de MainActivity. La
             orientación portrait que fijaba CapturaActivity ahora se aplica
             y se restaura en código (ver CapturaFragment.onResume /
             onBindingDestroy), porque ya no hay una Activity propia donde
             declararla en el Manifest. -->

        <!-- Contenedora del ciudadano Y del administrador (FASE 2): aloja según
             el rol el grafo nav_ciudadano o nav_admin. Reemplaza a
             AdminMainActivity, que desaparece. FASE 3 incorporó a esos grafos las
             pantallas que antes eran ".ui.detalle.DetalleActivity",
             ".ui.notificaciones.NotificacionesActivity",
             ".ui.configuracion.ConfiguracionActivity", ".ui.misdatos.MisDatosActivity"
             y ".ui.admin.ValidacionActivity": ya no son Activities, así que salen
             del manifest. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <!-- Para compartir el CSV de reportes exportado (parte municipal) con otras
             apps (correo, Drive) vía un content:// seguro, sin exponer el filesystem. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
