rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un vecino es admin si su doc en `usuarios` tiene rol == 'admin'. El rol
    // vive en el SERVIDOR: no se puede falsificar desde la app porque las reglas
    // de `usuarios` no dejan auto-promoverse (update obliga a conservar el rol).
    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.rol == 'ciudadano';
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.rol == resource.data.rol;
    }

    // Reserva de apodos (nickname único). doc id = apodo en minúscula, valor { uid }.
    // No guarda datos privados: cualquiera logueado puede consultar disponibilidad.
    // Solo se puede reservar uno nuevo a tu propio uid, y liberar el tuyo.
    match /nicknames/{nick} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /reportes/{id} {
      // Crear: cualquier vecino logueado, atado a su propio userId. El reporte
      // SIEMPRE nace en RECIBIDO: un cliente no puede crear uno ya RESUELTO/ANULADO.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.estado == 'RECIBIDO';

      // Leer: comunitario. Cualquier vecino logueado ve los focos de todos
      // (el Inicio muestra los puntos críticos de la comunidad, no solo los tuyos).
      allow read: if request.auth != null;

      // Editar: el DUEÑO corrige su reporte PERO sin cambiar el dueño, el estado
      // del flujo ni la severidad (validar/resolver/priorizar es potestad del
      // admin). El ADMIN puede editar cualquiera. El chequeo del dueño va primero
      // para no pagar las lecturas de esAdmin() en el caso común.
      allow update: if (request.auth != null
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.estado == resource.data.estado
                        && request.resource.data.severidad == resource.data.severidad)
                    || esAdmin();

      // Borrar: el DUEÑO retira su propio reporte; el ADMIN elimina cualquiera
      // (spam, falsos, duplicados).
      allow delete: if (request.auth != null
                        && resource.data.userId == request.auth.uid)
                    || esAdmin();
    }
  }
}
